{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@music-ui/music-core": ["../../packages/music-core/src/index.ts"],
      "@music-ui/ug-import": ["../../packages/ug-import/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
